# Local compose settings. Never commit the populated .env file.
POSTGRES_DB=devs
POSTGRES_USER=devs
POSTGRES_PASSWORD=change-me-locally
VITE_API_URL=http://localhost:8080/devs/api/v1

# Set false when testing the real central JWT integration locally.
DEVS_JWT_ENABLED=false
DEVS_ALLOW_INSECURE_ADMIN=true
DEVS_JWT_PUBLIC_KEY=
DEVS_JWT_ISSUER=
DEVS_ADMIN_SUBJECTS=

# Production provider values (optional for public/catalog development).
R2_ENABLED=false
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MUX_ENABLED=false
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_PLAYBACK_POLICY=public
